# ---------------------------------------------------------------------------
# THE ONE BARBER — PayFast integration
#
# Leave these EMPTY and the system runs in PayFast SANDBOX SIMULATION mode:
# the full flow (booking -> gateway page -> payment -> confirmation) works
# end-to-end against a simulated gateway so you can demo everything.
#
# Fill these in (copy this file to .env) and the real PayFast hosted checkout
# is used automatically — same code, no changes needed.
# ---------------------------------------------------------------------------

# Your PayFast Merchant ID (from payfast.co.za, or the sandbox portal)
PAYFAST_MERCHANT_ID=

# Your PayFast Merchant Key (the secret, keep it private)
PAYFAST_KEY=

# sandbox  = PayFast test environment (test cards)
# live     = real PayFast, real money
PAYFAST_MODE=sandbox
